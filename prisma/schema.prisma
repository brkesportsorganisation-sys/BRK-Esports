generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Mode {
  SOLO
  DUO
  SQUAD
}

enum Format {
  BR_RANKED
  CS_RANKED
}

enum Status {
  DRAFT
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  WALLET
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String?
  avatar        String?
  role          Role           @default(USER)
  freeFireUid   String?        @unique
  inGameName    String?
  walletBalance Float          @default(0.0)
  coinBalance   Float          @default(0.0)
  totalKills    Int            @default(0)
  totalWins     Int            @default(0)
  earnings      Float          @default(0.0)
  isBanned      Boolean        @default(false)
  referralCode  String         @unique @default(cuid())
  adminPermissions String[]    @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  teamMembers   TeamMember[]
  captainOf     Team[]         @relation("Captain")
  participants  Participant[]
  payments      Payment[]
  notifications Notification[]
  spinHistory   SpinHistory[]
}

model Team {
  id           String       @id @default(cuid())
  name         String
  tag          String       @unique
  logo         String?
  captainId    String
  captain      User         @relation("Captain", fields: [captainId], references: [id])
  inviteCode   String       @unique @default(cuid())
  createdAt    DateTime     @default(now())

  members      TeamMember[]
  participants Participant[]
  results      MatchResult[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER") // CAPTAIN, MEMBER
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Tournament {
  id                      String        @id @default(cuid())
  title                   String
  description             String
  banner                  String?
  bannerImage             String?
  thumbnailImage          String?
  logoImage               String?
  galleryImages           String?
  mode                    Mode
  format                  Format
  entryFee                Float         @default(0.0)
  prizePool               Float
  firstPrize              Float
  secondPrize             Float
  thirdPrize              Float
  perKillPrize            Float         @default(0.0)
  maxTeams                Int
  registeredCount         Int           @default(0)
  matchTime               DateTime
  registrationDeadline    DateTime
  status                  Status        @default(DRAFT)
  roomId                  String?
  roomPassword            String?
  roomEnabled             Boolean       @default(false)
  roomReleaseTime         DateTime?
  rules                   String?
  isPublished             Boolean       @default(false)
  isFeatured              Boolean       @default(false)
  showOnHomepage          Boolean       @default(true)
  registrationOpen        Boolean       @default(true)
  liveMatchToggle         Boolean       @default(false)
  communityEnabled        Boolean       @default(false)
  communityAccessType     String        @default("WHATSAPP")
  communityInviteLink     String?
  communityName           String?
  communityDescription    String?
  hideInviteLinkFromPublic Boolean      @default(true)
  communityUnlockMode     String        @default("SLOT_PURCHASE_ONLY")
  communityIsDisabled     Boolean       @default(false)
  tournamentStart         DateTime?
  tournamentEnd           DateTime?
  registrationStart       DateTime?
  registrationEnd         DateTime?
  timeZone                String        @default("Asia/Dhaka")
  isPaused                Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  participants            Participant[]
  payments                Payment[]
  results                 MatchResult[]
}

model Participant {
  id                      String        @id @default(cuid())
  tournamentId            String
  userId                  String
  teamId                  String?
  status                  PaymentStatus @default(PENDING)
  joinedAt                DateTime      @default(now())

  // Detailed squad registration fields
  registrationId          String?       @unique
  squadName               String?
  iglName                 String?
  captainWhatsApp         String?
  captainDiscord          String?
  player1Name             String?
  player2Name             String?
  player3Name             String?
  player4Name             String?
  backupPlayerName        String?

  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id])
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  tournamentId String?
  method       PaymentMethod
  amount       Float
  trxId        String        @unique
  screenshot   String?
  status       PaymentStatus @default(PENDING)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament?   @relation(fields: [tournamentId], references: [id])
}

model MatchResult {
  id           String     @id @default(cuid())
  tournamentId String
  teamId       String?
  playerName   String
  ffUid        String?
  kills        Int        @default(0)
  placement    Int        @default(0)
  points       Float      @default(0.0)
  createdAt    DateTime   @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team?      @relation(fields: [teamId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("GENERAL") // GENERAL, UPDATE, TOURNAMENT
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SpinHistory {
  id        String   @id @default(cuid())
  userId    String
  reward    String
  amount    Float    @default(0.0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
