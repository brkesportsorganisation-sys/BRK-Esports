PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/whatsapp_bot?retryWrites=true&w=majority

# Comma-separated list of target group JIDs (get these after first connect — see README step 5)
TARGET_GROUPS=120363xxx1@g.us,120363xxx2@g.us,120363xxx3@g.us,120363xxx4@g.us,120363xxx5@g.us

# The channel JID you want to auto-forward messages FROM
SOURCE_CHANNEL_JID=120363xxx_channel@newsletter

# Simple shared secret so only your Vercel frontend can call the schedule API
API_SECRET=change_this_to_a_long_random_string
