PORT=5000

# MongoDB Atlas connection string
# Get from: Atlas → Connect → Drivers → copy connection string
# Add database name: .../whatsapp_automation?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/whatsapp_automation?retryWrites=true&w=majority

# Comma-separated target group JIDs (get these after first connect using /api/get-groups)
# Example: 120363028392819283@g.us,120363028392819284@g.us
TARGET_GROUPS=

# The channel JID to auto-forward messages FROM (ends in @newsletter)
SOURCE_CHANNEL_JID=

# Simple shared secret so only your Vercel frontend can call the API
# Must match WHATSAPP_BOT_SECRET on Vercel
API_SECRET=change_this_to_a_long_random_string

# Your Vercel frontend URL (for CORS - no trailing slash)
# Example: https://esportszonebd.online
ALLOWED_ORIGIN=https://your-vercel-app.vercel.app

# Extra allowed origins comma separated (optional)
# ALLOWED_ORIGINS_EXTRA=https://other-domain.com
